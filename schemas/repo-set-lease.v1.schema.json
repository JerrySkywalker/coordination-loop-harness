{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository-set lease v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lease_id",
    "run_id",
    "state",
    "generation",
    "created_utc",
    "owner",
    "coordination_repository",
    "repositories",
    "local_scopes",
    "infrastructure_scopes",
    "active_writer_repository",
    "decision_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "coord.repo-set-lease.v1"
    },
    "lease_id": {
      "$ref": "#/$defs/runId"
    },
    "run_id": {
      "$ref": "#/$defs/runId"
    },
    "state": {
      "enum": [
        "ACTIVE",
        "RELEASED"
      ]
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "created_utc": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "coordination_repository": {
      "$ref": "#/$defs/repositoryName"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "mode"
        ],
        "properties": {
          "repository": {
            "$ref": "#/$defs/repositoryName"
          },
          "mode": {
            "enum": [
              "WRITE",
              "READ"
            ]
          },
          "canonical_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "worktree_root": {
            "type": [
              "string",
              "null"
            ]
          },
          "exact_sha": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "local_scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "infrastructure_scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "active_writer_repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "released_utc": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "repositoryName": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$",
      "minLength": 3
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    }
  }
}
