{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owner decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "run_id",
    "decision_type",
    "status",
    "issued_by",
    "issued_utc",
    "decision",
    "rationale",
    "scope",
    "conditions"
  ],
  "properties": {
    "schema_version": {
      "const": "coord.decision.v1"
    },
    "decision_id": {
      "$ref": "#/$defs/runId"
    },
    "run_id": {
      "$ref": "#/$defs/runId"
    },
    "decision_type": {
      "enum": [
        "OWNER_GATE",
        "SCOPE_CHANGE",
        "LEASE_TRANSFER",
        "PRODUCTION_APPLY",
        "BLOCKER_DISPOSITION"
      ]
    },
    "status": {
      "enum": [
        "APPROVED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "issued_by": {
      "type": "string",
      "minLength": 1
    },
    "issued_utc": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "repositoryName": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$",
      "minLength": 3
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    }
  }
}
