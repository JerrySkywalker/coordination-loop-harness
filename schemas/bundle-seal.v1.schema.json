{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sealed Run Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "algorithm",
    "encoding",
    "files",
    "markdown_json_bindings",
    "local_evidence_included"
  ],
  "properties": {
    "schema_version": {"const": "coord.bundle-seal.v1"},
    "run_id": {"$ref": "#/$defs/runId"},
    "algorithm": {"const": "sha256"},
    "encoding": {"const": "utf-8"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file"},
      "uniqueItems": true
    },
    "markdown_json_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "json_path",
          "json_sha256",
          "markdown_path",
          "markdown_sha256"
        ],
        "properties": {
          "json_path": {"type": "string", "minLength": 1},
          "json_sha256": {"$ref": "#/$defs/sha"},
          "markdown_path": {"type": "string", "minLength": 1},
          "markdown_sha256": {"$ref": "#/$defs/sha"}
        }
      }
    },
    "local_evidence_included": {"const": false}
  },
  "$defs": {
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
