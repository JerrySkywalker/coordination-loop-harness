{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coordination Loop generic Harness Model v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_id",
    "axes",
    "proof_vector_axes",
    "budget_ledger",
    "progress_semantics",
    "protected_state_semantics"
  ],
  "properties": {
    "schema_version": {"const": "coord.harness-model.v1"},
    "model_id": {"const": "coord.harness-model.v1"},
    "axes": {"$ref": "#/$defs/axes"},
    "proof_vector_axes": {
      "const": ["V", "E", "F", "G"]
    },
    "budget_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tuple_fields", "no_borrow", "replenishment_requires_lifetime_cap"],
      "properties": {
        "tuple_fields": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "no_borrow": {"const": true},
        "replenishment_requires_lifetime_cap": {"const": true}
      }
    },
    "progress_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_states", "advancing_states", "identical_failure_is_not_progress"],
      "properties": {
        "initial_states": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "advancing_states": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "identical_failure_is_not_progress": {"const": true}
      }
    },
    "protected_state_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_never_expands_automatically",
        "protected_retry_requires_verified_rollback",
        "owner_actions_require_owner_decision"
      ],
      "properties": {
        "authority_never_expands_automatically": {"const": true},
        "protected_retry_requires_verified_rollback": {"const": true},
        "owner_actions_require_owner_decision": {"const": true}
      }
    }
  },
  "$defs": {
    "axisValues": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 32}
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "P", "V", "E", "F", "G", "L"],
      "properties": {
        "A": {"$ref": "#/$defs/axisValues"},
        "B": {"$ref": "#/$defs/axisValues"},
        "P": {"$ref": "#/$defs/axisValues"},
        "V": {"$ref": "#/$defs/axisValues"},
        "E": {"$ref": "#/$defs/axisValues"},
        "F": {"$ref": "#/$defs/axisValues"},
        "G": {"$ref": "#/$defs/axisValues"},
        "L": {"$ref": "#/$defs/axisValues"}
      }
    }
  }
}
