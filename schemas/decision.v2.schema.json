{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verified owner decision v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "run_id",
    "sequence",
    "decision_type",
    "status",
    "issued_by",
    "issued_utc",
    "decision",
    "rationale",
    "scope",
    "conditions",
    "authorized_actions",
    "lease_id",
    "lease_generation",
    "previous_decision_ref",
    "markdown_sha256"
  ],
  "properties": {
    "schema_version": {"const": "coord.decision.v2"},
    "decision_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "sequence": {"type": "integer", "minimum": 1},
    "decision_type": {
      "enum": [
        "OWNER_GATE",
        "SCOPE_CHANGE",
        "LEASE_TRANSFER",
        "PRODUCTION_APPLY",
        "BLOCKER_DISPOSITION"
      ]
    },
    "status": {"enum": ["ACCEPTED", "MERGED", "REJECTED", "SUPERSEDED"]},
    "issued_by": {"type": "string", "minLength": 1},
    "issued_utc": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "decision": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "items": {"type": "string"}},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "authorized_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "lease_id": {"type": ["string", "null"]},
    "lease_generation": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "lease_candidate_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_decision_ref": {"type": ["string", "null"]},
    "markdown_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  }
}
