{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coordination plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "title",
    "created_utc",
    "planned_repo_set",
    "phases",
    "infrastructure_apply_default"
  ],
  "properties": {
    "schema_version": {
      "const": "coord.plan.v1"
    },
    "run_id": {
      "$ref": "#/$defs/runId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created_utc": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "planned_repo_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryName"
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase_id",
          "title",
          "write_repositories",
          "read_repositories",
          "entry_gate",
          "exit_gate"
        ],
        "properties": {
          "phase_id": {
            "$ref": "#/$defs/runId"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "write_repositories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/repositoryName"
            }
          },
          "read_repositories": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/repositoryName"
            }
          },
          "entry_gate": {
            "type": "string",
            "minLength": 1
          },
          "exit_gate": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "infrastructure_apply_default": {
      "enum": [
        "DENY",
        "ALLOW_WITH_OWNER_GATE"
      ]
    }
  },
  "$defs": {
    "repositoryName": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$",
      "minLength": 3
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    }
  }
}
