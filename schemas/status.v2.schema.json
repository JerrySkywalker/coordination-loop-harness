{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run status v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "revision",
    "generation",
    "state",
    "checkpoint",
    "active_phase",
    "active_writer",
    "lease_id",
    "product_writes_started",
    "updated_utc",
    "history"
  ],
  "properties": {
    "schema_version": {"const": "coord.status.v2"},
    "run_id": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1},
    "generation": {"type": "integer", "minimum": 1},
    "state": {
      "enum": [
        "PLANNED",
        "ADMITTED",
        "RUNNING",
        "BLOCKED",
        "OWNER_ACTION_REQUIRED",
        "COMPLETE",
        "ABORTED"
      ]
    },
    "checkpoint": {"type": "string", "minLength": 1},
    "active_phase": {"type": ["string", "null"]},
    "active_writer": {"type": ["string", "null"]},
    "lease_id": {"type": ["string", "null"]},
    "product_writes_started": {"type": "boolean"},
    "updated_utc": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "generation",
          "timestamp",
          "checkpoint",
          "decision_ref"
        ],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "generation": {"type": "integer", "minimum": 2},
          "timestamp": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
          "checkpoint": {"type": "string", "minLength": 1},
          "decision_ref": {"type": ["string", "null"]}
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  }
}
