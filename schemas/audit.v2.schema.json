{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "run_id",
    "audit_type",
    "auditor",
    "audited_utc",
    "audited_sha",
    "result",
    "finding_count",
    "findings",
    "read_only_asserted",
    "read_only_verified",
    "independently_launched_asserted",
    "independently_launched_verified",
    "markdown_sha256",
    "sensitive_output"
  ],
  "properties": {
    "schema_version": {"const": "coord.audit.v2"},
    "audit_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "audit_type": {"enum": ["EXACT_HEAD", "EXACT_MAIN"]},
    "auditor": {"type": "string", "minLength": 1},
    "audited_utc": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "audited_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "result": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "finding_count": {"type": "integer", "minimum": 0},
    "findings": {"type": "array", "items": {"type": "string"}},
    "read_only_asserted": {"type": "boolean"},
    "read_only_verified": {"type": ["boolean", "null"]},
    "independently_launched_asserted": {"type": "boolean"},
    "independently_launched_verified": {"type": ["boolean", "null"]},
    "markdown_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sensitive_output": {"const": false}
  },
  "allOf": [
    {
      "if": {
        "properties": {"result": {"const": "PASS"}},
        "required": ["result"]
      },
      "then": {
        "properties": {
          "finding_count": {"const": 0},
          "findings": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"result": {"enum": ["FAIL", "BLOCKED"]}},
        "required": ["result"]
      },
      "then": {
        "properties": {
          "finding_count": {"minimum": 1},
          "findings": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  }
}
