{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coordination Loop Profile Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_pack_id",
    "model_ref",
    "baseline",
    "budget_ledger",
    "profiles"
  ],
  "properties": {
    "schema_version": {"const": "coord.profile-pack.v1"},
    "profile_pack_id": {"$ref": "#/$defs/id"},
    "model_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "model_id"],
      "properties": {
        "schema_version": {"const": "coord.harness-model.v1"},
        "model_id": {"const": "coord.harness-model.v1"}
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": true,
      "required": ["baseline_id"],
      "properties": {"baseline_id": {"$ref": "#/$defs/id"}}
    },
    "budget_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domains", "tuple_fields"],
      "properties": {
        "domains": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "tuple_fields": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "units": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/profile"}
    },
    "calibration": {"type": "object"},
    "provenance": {"type": "object"},
    "legacy_equivalence": {"type": "object"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "profile": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "allowed_authority_classes",
        "elasticity_grade",
        "initial_progress_state",
        "allowed_layers",
        "default_proof_vectors",
        "budget_matrix"
      ],
      "properties": {
        "allowed_authority_classes": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "elasticity_grade": {"type": "string", "minLength": 1, "maxLength": 32},
        "initial_progress_state": {"type": "string", "minLength": 1, "maxLength": 32},
        "allowed_layers": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "default_proof_vectors": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "budget_matrix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
