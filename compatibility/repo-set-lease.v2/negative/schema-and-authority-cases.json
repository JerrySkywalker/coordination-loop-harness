          "value": 2.0
        }
      ],
      "expected_layer": "SEMANTIC_REJECT"
    },
    {
      "case": "decision-lease-generation-outside-safe-integer-range",
      "base": "release_decision",
      "patch": [
        {
          "op": "replace",
