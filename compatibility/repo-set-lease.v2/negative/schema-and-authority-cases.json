      "patch": [
        {
          "op": "replace",
          "path": "/repositories/0/branch_ref",
          "value": "refs/heads/a/../../outside"
        }
      ],
      "expected_layer": "SCHEMA_REJECT"
    },
    {
      "case": "read-branch-ref-parent-component",
      "base": "active",
      "patch": [
        {
          "op": "replace",
          "path": "/repositories/0/mode",
          "value": "READ"
        },
        {
          "op": "replace",
          "path": "/active_writer_repository",
          "value": null
        },
        {
          "op": "replace",
          "path": "/repositories/0/branch_ref",
          "value": "refs/heads/a/../../outside"
        }
      ],
      "expected_layer": "SCHEMA_REJECT"
    },
    {
      "case": "active-generation-outside-safe-integer-range",
