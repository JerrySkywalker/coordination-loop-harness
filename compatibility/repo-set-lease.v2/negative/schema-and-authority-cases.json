      "patch": [
        {
          "op": "remove",
          "path": "/release_decision_ref"
        }
      ],
      "expected_layer": "SCHEMA_REJECT"
    },
    {
      "case": "released-without-release-authority",
      "base": "terminal",
      "patch": [
        {
          "op": "remove",
          "path": "/release_authority"
        }
      ],
      "expected_layer": "SCHEMA_REJECT"
    },
    {
      "case": "released-generation-one",
      "base": "terminal",
      "patch": [
        {
          "op": "replace",
          "path": "/generation",
          "value": 1
        }
      ],
      "expected_layer": "SCHEMA_REJECT"
    },
    {
      "case": "released-outcome-parent-traversal",
      "base": "terminal",
