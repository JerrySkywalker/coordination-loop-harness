      "expected_layer": "SCHEMA_REJECT"
    },
    {
      "case": "active-posix-worktree-with-backslash",
      "base": "active",
      "patch": [
        {
          "op": "replace",
          "path": "/repositories/0/worktree_root",
          "value": "/tmp/writer\\alias"
        }
      ],
      "expected_layer": "SCHEMA_REJECT"
    },
    {
      "case": "active-repository-clone-suffix",
      "base": "active",
      "patch": [
        {
          "op": "replace",
          "path": "/repositories/0/repository",
          "value": "example/clh.GIT"
        }
