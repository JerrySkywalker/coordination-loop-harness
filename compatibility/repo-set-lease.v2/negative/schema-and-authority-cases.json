        {
          "op": "replace",
          "path": "/repositories/0/repository",
          "value": "git@GITHUB.COM:example/clh"
        }
      ],
      "expected_layer": "SCHEMA_REJECT"
    },
    {
      "case": "active-blank-infrastructure-scope",
      "base": "active",
      "patch": [
        {
          "op": "add",
