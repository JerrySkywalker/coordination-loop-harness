      "expected": "AUTHORIZATION_REJECT"
    },
    {
      "case": "release-must-directly-follow-active-decision",
      "previous_decision_ref": "decisions/OTHER/DEC-1.json",
      "expected": "AUTHORIZATION_REJECT"
    }
  ]
