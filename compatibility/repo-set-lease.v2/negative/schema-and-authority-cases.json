{
  "schema_version": "repo-set-lease-v2-negative-semantics.v1",
  "bases": {
    "active": "compatibility/repo-set-lease.v2/positive/candidate-digest.json#/candidate",
    "terminal": "compatibility/repo-set-lease.v2/positive/terminal-release.json#/terminal_candidate",
    "release_decision": "compatibility/repo-set-lease.v2/positive/terminal-release.json#/release_decision",
    "active_decision": "compatibility/repo-set-lease.v2/positive/terminal-release.json#/active_decision"
  },
  "document_cases": [
    {
      "case": "active-with-terminal-field",
      "base": "active",
      "patch": [
        {
          "op": "replace",
          "path": "/outcome_sha256",
          "value": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      ],
      "expected_layer": "SCHEMA_REJECT"
    },
    {
      "case": "active-with-null-decision-ref",
      "base": "active",
      "patch": [
        {
          "op": "replace",
          "path": "/decision_ref",
          "value": null
        }
      ],
      "expected_layer": "SCHEMA_REJECT"
    },
    {
      "case": "active-writer-without-write",
      "base": "active",
      "patch": [
        {
          "op": "replace",
          "path": "/repositories/0/mode",
          "value": "READ"
        }
      ],
      "expected_layer": "SCHEMA_REJECT"
    },
    {
      "case": "two-writers",
      "base": "active",
      "patch": [
        {
          "op": "add",
          "path": "/repositories/-",
          "value": {
            "repository": "example/second",
            "mode": "WRITE",
            "canonical_path": "V:/src/second",
            "worktree_root": "V:/src/_worktrees/second",
            "branch_ref": "refs/heads/agent/second",
            "exact_sha": "2222222222222222222222222222222222222222"
          }
        }
      ],
      "expected_layer": "SCHEMA_REJECT"
    },
    {
      "case": "write-with-null-active-writer",
      "base": "active",
      "patch": [
        {
          "op": "replace",
          "path": "/active_writer_repository",
          "value": null
        }
      ],
      "expected_layer": "SCHEMA_REJECT"
    },
    {
      "case": "released-with-active-writer",
      "base": "terminal",
      "patch": [
        {
          "op": "replace",
          "path": "/active_writer_repository",
          "value": "example/clh"
        }
      ],
      "expected_layer": "SCHEMA_REJECT"
    },
    {
      "case": "released-without-outcome-digest",
      "base": "terminal",
      "patch": [
        {
          "op": "remove",
          "path": "/outcome_sha256"
        }
      ],
      "expected_layer": "SCHEMA_REJECT"
    },
    {
      "case": "released-without-release-decision-ref",
