          "op": "add",
          "path": "/infrastructure_scopes/-",
          "value": " runner:host "
        }
      ],
      "expected_layer": "SCHEMA_REJECT"
    },
    {
      "case": "terminal-duplicate-canonical-repository",
      "base": "terminal",
      "patch": [
        {
          "op": "add",
          "path": "/repositories/-",
          "value": {
            "repository": "EXAMPLE/CLH",
            "mode": "READ",
            "canonical_path": "V:/src/coordination-loop-harness",
            "worktree_root": "V:/src/_worktrees/vector/coordination-loop-harness",
            "branch_ref": "refs/heads/agent/vector",
            "exact_sha": "1111111111111111111111111111111111111111"
          }
        }
      ],
      "expected_layer": "SEMANTIC_REJECT"
    },
    {
      "case": "active-writer-value-mismatch",
      "base": "active",
      "patch": [
        {
          "op": "replace",
          "path": "/active_writer_repository",
          "value": "example/other"
        }
      ],
      "expected_layer": "SEMANTIC_REJECT"
    },
    {
      "case": "active-writer-case-only-mismatch",
      "base": "active",
      "patch": [
        {
          "op": "replace",
          "path": "/active_writer_repository",
          "value": "Example/CLH"
        }
      ],
      "expected_layer": "SEMANTIC_REJECT"
    }
  ],
